# Copy this file to .env.local and fill in your own values.
# Restart `npm run dev` after creating/editing this file.

# Google Maps: console.cloud.google.com > APIs & Services > enable "Maps
# JavaScript API" > Credentials > create an API key. Restrict it to your
# domain(s) under "Application restrictions" once you're ready to deploy.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyCgXWQpVLzlJmMvsU0tLUgGDG07sQM1a2s

# Firebase: console.firebase.google.com > Project settings > your Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAyG32LLKCiZUjtdTyN4gCq_Z17JHbZlhM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hydmap-9c92c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hydmap-9c92c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hydmap-9c92c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1069871180320
NEXT_PUBLIC_FIREBASE_APP_ID=1:1069871180320:web:fca8864104e8833afe2a45

# WAQI (World Air Quality Index), for the AQI map control: free token from
# https://aqicn.org/data-platform/token/ — no credit card, just email signup.
NEXT_PUBLIC_WAQI_TOKEN=YOUR_WAQI_TOKEN

# --- Server-only secrets below: deliberately NOT prefixed NEXT_PUBLIC_, so
# they're never bundled into client-side JS. See the README's "Comment
# notifications" setup section.

# Resend (email), for notifying a post's owner about a new comment:
# resend.com > API Keys > Create API Key. Free tier, no credit card.
RESEND_API_KEY=YOUR_RESEND_API_KEY

# Firebase Admin SDK service account, so the notify API route can read a
# post's private `email` field server-side (never exposed to any
# client-side query). Firebase console > Project Settings > Service
# Accounts > Generate new private key — downloads a JSON file; paste its
# *entire* contents here as one unbroken line (keep the quotes).
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...",...}'
